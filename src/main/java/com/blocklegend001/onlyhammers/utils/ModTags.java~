package com.blocklegend001.onlyhammers.utils;

import com.blocklegend001.onlyhammers.OnlyHammers;
import net.minecraft.core.registries.Registries;
import net.minecraft.resources.ResourceLocation;
import net.minecraft.tags.TagKey;
import net.minecraft.world.item.Item;

public class ModTags {
    public static class Items {
        public static final TagKey<Item> WOODEN_HAMMERS = modItemTag("wooden_hammers");
        public static final TagKey<Item> STONE_HAMMERS = modItemTag("stone_hammers");
        public static final TagKey<Item> IRON_HAMMERS = modItemTag("iron_hammers");
        public static final TagKey<Item> GOLD_HAMMERS = modItemTag("gold_hammers");
        public static final TagKey<Item> LAPIS_HAMMERS = modItemTag("lapis_hammers");
        public static final TagKey<Item> REDSTONE_HAMMERS = modItemTag("redstone_hammers");
        public static final TagKey<Item> DIAMOND_HAMMERS = modItemTag("diamond_hammers");
        public static final TagKey<Item> EMERALD_HAMMERS = modItemTag("emerald_hammers");
        public static final TagKey<Item> OBSIDIAN_HAMMERS = modItemTag("obsidian_hammers");
        public static final TagKey<Item> NETHERITE_HAMMERS = modItemTag("netherite_hammers");

        public static final TagKey<Item> LAPIS_HAMMERS_REPAIRS = modItemTag("lapis_hammers_repairs");
        public static final TagKey<Item> REDSTONE_HAMMERS_REPAIRS = modItemTag("redstone_hammers_repairs");
        public static final TagKey<Item> EMERALD_HAMMERS_REPAIRS = modItemTag("emerald_hammers_repairs");
        public static final TagKey<Item> OBSIDIAN_HAMMERS_REPAIRS = modItemTag("obsidian_hammers_repairs");
    }

    public static TagKey<Item> itemTag(ResourceLocation tagLoc) {
        return TagKey.create(Registries.ITEM, tagLoc);
    }

    private static TagKey<Item> modItemTag(String tagName) {
        return ModTags.itemTag(ResourceLocation.fromNamespaceAndPath(OnlyHammers.MOD_ID, tagName));
    }
}